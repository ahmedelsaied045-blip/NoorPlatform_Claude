@model NoorAiWidgetModel

@using Nop.Plugin.Misc.NoorAiAssistant.Models

@{
    //bump this whenever noor-ai.css / noor-ai.js change: plugin static files are served with the store's
    //long static-file cache, so without a version returning visitors keep the old assets
    var assetVersion = "20260714a";

    NopHtml.AddCssFileParts($"~/Plugins/Misc.NoorAiAssistant/Content/noor-ai.css?v={assetVersion}", excludeFromBundle: true);
    NopHtml.AddScriptParts(ResourceLocation.Footer, $"~/Plugins/Misc.NoorAiAssistant/Content/noor-ai.js?v={assetVersion}", excludeFromBundle: true);
}

@*
    Every user-visible string is passed in as a data-* attribute rather than being written into the
    JavaScript. The script is a static file — it is not rendered by Razor and cannot call @T(...) — so this
    is how the chat window stays localisable through nopCommerce's own string resources.
*@
<div id="noor-ai"
     class="noor-ai"
     dir="@(Model.IsRtl ? "rtl" : "ltr")"
     style="--noor-ai-accent: @Model.ThemeColor;"
     data-rtl="@Model.IsRtl.ToString().ToLowerInvariant()"
     data-t-thinking="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Thinking")"
     data-t-copy="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Copy")"
     data-t-copied="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Copied")"
     data-t-view="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.ViewDetails")"
     data-t-cart="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.AddToCart")"
     data-t-off="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Off")"
     data-t-recommended="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Recommended")"
     data-t-nohistory="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.NoHistory")"
     data-t-clearconfirm="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.ClearConfirm")"
     data-t-error="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Error")">

    @* ---------- launcher ---------- *@
    <button type="button"
            class="noor-ai__launcher"
            id="noor-ai-launcher"
            aria-label="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Launcher")"
            aria-expanded="false"
            aria-controls="noor-ai-panel">
        <svg class="noor-ai__launcher-icon noor-ai__launcher-icon--open" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2a7 7 0 0 0-4 12.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26A7 7 0 0 0 12 2Z" />
            <path d="M9 20h6" />
            <path d="M10 22h4" />
        </svg>
        <svg class="noor-ai__launcher-icon noor-ai__launcher-icon--close" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" />
        </svg>
    </button>

    @* ---------- panel ---------- *@
    <section class="noor-ai__panel"
             id="noor-ai-panel"
             role="dialog"
             aria-modal="false"
             aria-labelledby="noor-ai-title"
             hidden>

        <header class="noor-ai__header">
            <div class="noor-ai__brand">
                <span class="noor-ai__avatar" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 2a7 7 0 0 0-4 12.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26A7 7 0 0 0 12 2Z" />
                        <path d="M9 20h6" />
                    </svg>
                </span>
                <span class="noor-ai__brand-text">
                    <strong id="noor-ai-title">@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Title")</strong>
                    <small>@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Subtitle")</small>
                </span>
            </div>

            <div class="noor-ai__actions">
                <button type="button" class="noor-ai__icon-btn" id="noor-ai-history-toggle"
                        title="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.History")"
                        aria-label="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.History")">
                    <svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /><path d="M12 7v5l3 2" /></svg>
                </button>
                <button type="button" class="noor-ai__icon-btn" id="noor-ai-new"
                        title="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.NewChat")"
                        aria-label="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.NewChat")">
                    <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
                </button>
                <button type="button" class="noor-ai__icon-btn" id="noor-ai-theme"
                        title="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.ToggleTheme")"
                        aria-label="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.ToggleTheme")">
                    <svg class="noor-ai__icon--moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
                    <svg class="noor-ai__icon--sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                </button>
                <button type="button" class="noor-ai__icon-btn" id="noor-ai-close"
                        title="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Close")"
                        aria-label="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Close")">
                    <svg viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            </div>
        </header>

        @* ---------- history drawer ---------- *@
        <div class="noor-ai__history" id="noor-ai-history" hidden>
            <div class="noor-ai__history-head">
                <span>@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.History")</span>
                <button type="button" class="noor-ai__link-btn noor-ai__link-btn--danger" id="noor-ai-clear">
                    @T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.ClearHistory")
                </button>
            </div>
            <ul class="noor-ai__history-list" id="noor-ai-history-list"></ul>
        </div>

        @* ---------- messages ---------- *@
        <div class="noor-ai__messages" id="noor-ai-messages" role="log" aria-live="polite" aria-atomic="false">
            <div class="noor-ai__empty" id="noor-ai-empty">
                <span class="noor-ai__empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 2a7 7 0 0 0-4 12.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26A7 7 0 0 0 12 2Z" />
                        <path d="M9 20h6" />
                    </svg>
                </span>
                <p class="noor-ai__welcome" id="noor-ai-welcome"></p>
                <div class="noor-ai__chips" id="noor-ai-suggestions"></div>
            </div>
        </div>

        @* ---------- composer ---------- *@
        <form class="noor-ai__composer" id="noor-ai-form" autocomplete="off">
            <div class="noor-ai__input-wrap">
                <textarea id="noor-ai-input"
                          class="noor-ai__input"
                          rows="1"
                          maxlength="1000"
                          placeholder="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Placeholder")"
                          aria-label="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Placeholder")"></textarea>

                <button type="submit"
                        class="noor-ai__send"
                        id="noor-ai-send"
                        disabled
                        aria-label="@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Send")">
                    <svg class="noor-ai__send-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 12h15M13 6l6 6-6 6" />
                    </svg>
                    <span class="noor-ai__spinner" aria-hidden="true"></span>
                </button>
            </div>
            <small class="noor-ai__hint">@T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.Public.Hint")</small>
        </form>
    </section>
</div>
