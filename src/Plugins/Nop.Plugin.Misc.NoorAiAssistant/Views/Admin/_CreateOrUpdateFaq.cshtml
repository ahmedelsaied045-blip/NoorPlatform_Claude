@model FaqModel

<div class="card-body">
    <input asp-for="Id" type="hidden" />

    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Question" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Question" />
            <span asp-validation-for="Question"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Answer" />
        </div>
        <div class="col-md-9">
            <nop-textarea asp-for="Answer" rows="8" />
            <span asp-validation-for="Answer"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Keywords" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Keywords" />
            <span asp-validation-for="Keywords"></span>
            <small class="text-muted d-block mt-1">
                This is what actually routes a shopper's question to this answer. Include the words people really
                type, in every language you support — <code>shipping,delivery,شحن,توصيل</code>. Accents, Arabic
                spelling variants (إنارة / انارة) and letter forms are normalised automatically, so you only need
                each word once.
            </small>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="TopicId" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="TopicId" asp-items="Model.AvailableTopics" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="LanguageId" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="LanguageId" asp-items="Model.AvailableLanguages" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="StoreId" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="StoreId" asp-items="Model.AvailableStores" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="DisplayOrder" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="DisplayOrder" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Published" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Published" />
        </div>
    </div>
</div>
