@model SuggestedQuestionModel

@{
    ViewBag.PageTitle = T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.SuggestedQuestions.AddNew").Text;
    NopHtml.SetActiveMenuItemSystemName(NoorAiAssistantDefaults.ADMIN_MENU_QUESTIONS_SYSTEM_NAME);
}

<form asp-controller="NoorAiAssistantAdmin" asp-action="QuestionCreate" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.SuggestedQuestions.AddNew")
            <small>
                <i class="fas fa-arrow-turn-up"></i>
                <a asp-controller="NoorAiAssistantAdmin" asp-action="QuestionList">
                    @T($"{NoorAiAssistantDefaults.LOCALE_RESOURCE_PREFIX}.SuggestedQuestions.BackToList")
                </a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default">
                        @await Html.PartialAsync("~/Plugins/Misc.NoorAiAssistant/Views/Admin/_CreateOrUpdateQuestion.cshtml", Model)
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
