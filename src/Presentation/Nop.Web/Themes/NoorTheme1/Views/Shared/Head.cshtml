@using Nop.Core.Domain.Catalog
@using Nop.Services.Helpers

@inject CatalogSettings catalogSettings
@inject IThemeContext themeContext
@inject IUserAgentHelper userAgentHelper

@{
    Layout ="";
    var themeName = await themeContext.GetWorkingThemeNameAsync();
    var supportRtl = await Html.ShouldUseRtlThemeAsync();

    // Cache-buster for theme CSS. Static files are served with a 1-year
    // Cache-Control (StaticFilesCacheControl in appsettings.json), so without a
    // version in the URL, published CSS changes never reach returning visitors.
    // Bump this token whenever styles.css / styles.rtl.css / noor-lighting.css change.
    var noorCssVer = "20260701a";

    //add main CSS file (versioned so edits show up after publish)
    NopHtml.AppendCssFileParts($"~/Themes/{themeName}/Content/css/styles{(supportRtl ? ".rtl" : "")}.css?v={noorCssVer}");

    // Noor Lighting custom styles.
    NopHtml.AppendCssFileParts($"~/Themes/{themeName}/Content/css/noor-lighting.css?v={noorCssVer}");

    // Noor Lighting carousel (home-page category/product navigation)
    NopHtml.AppendScriptParts(ResourceLocation.Footer, $"~/Themes/{themeName}/Content/js/noor-carousel.js", excludeFromBundle: true);

    // Arabic font
    NopHtml.AppendCssFileParts("https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap", excludeFromBundle: true);
    
    //Swiper powers the hero products slider, so it must always be available on themed pages.
    //(by default nopCommerce only loads it when DisplayAllPicturesOnCatalogPages is enabled)
    NopHtml.AppendCssFileParts("~/lib_npm/swiper/swiper-bundle.min.css");
    if (!catalogSettings.DisplayAllPicturesOnCatalogPages)
    {
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/swiper/swiper-bundle.min.js");
    }

    //add jQuery UI css file
    NopHtml.AppendCssFileParts("~/lib_npm/jquery-ui-dist/jquery-ui.min.css");
}
@* PWA: make the site installable and app-like on mobile (manifest + icons + meta).
   This partial is rendered inside <head>, so the tags are emitted directly here.
   viewport-fit=cover (declared after the default viewport) lets the bottom tab bar
   respect notch / safe-area insets. *@
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<link rel="manifest" href="/noor-app.webmanifest" />
<meta name="theme-color" content="#1A1A1A" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="نور" />
<link rel="apple-touch-icon" href="/icons/bulb-192.png" />