<header class="header">
    <a class="skip" href="#main">@T("Header.SkipNavigation.Text")</a>
    <div class="header-announcement">
        <div class="header-announcement__inner">
            <span>🚚 شحن مجاني لكل الطلبات فوق 5 الالاف جنيه – لفترة محدودة</span>
        </div>
    </div>
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderBefore })
    <div class="header-upper">
        <div class="header-links-wrapper">
            @await Component.InvokeAsync(typeof(HeaderLinksViewComponent))
            @await Component.InvokeAsync(typeof(FlyoutShoppingCartViewComponent))
        </div>
        <div class="header-selectors-wrapper">
            @await Component.InvokeAsync(typeof(TaxTypeSelectorViewComponent))
            @await Component.InvokeAsync(typeof(CurrencySelectorViewComponent))
            @await Component.InvokeAsync(typeof(LanguageSelectorViewComponent))
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderSelectors })
        </div>
    </div>
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderMiddle })
    <div class="header-lower">
        <div class="header-logo">
            @await Component.InvokeAsync(typeof(LogoViewComponent))
        </div>
        <div role="search" class="search-box store-search-box">
            @await Component.InvokeAsync(typeof(SearchBoxViewComponent))
        </div>
    </div>
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderAfter })
</header>

@* App-like bottom navigation — shown only on phones (see .noor-tabbar in noor-lighting.css) *@
<nav class="noor-tabbar" aria-label="التنقل السريع">
    <a class="noor-tabbar__item" href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5"/><path d="M5 10v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-9"/><path d="M9 21v-6h6v6"/></svg>
        <span>الرئيسية</span>
    </a>
    <a class="noor-tabbar__item" href="@(Url.RouteUrl(NopRouteNames.General.SEARCH))?q=">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <span>المتجر</span>
    </a>
    <a class="noor-tabbar__item" href="@Url.RouteUrl(NopRouteNames.General.VISUALIZE)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-4.5-4.5L7 20"/></svg>
        <span>تصوّر</span>
    </a>
    <a class="noor-tabbar__item noor-tabbar__item--cart" href="@Url.RouteUrl(NopRouteNames.General.CART)">
        <span class="noor-tabbar__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h3l2.4 12.4a1.5 1.5 0 0 0 1.5 1.2h8.3a1.5 1.5 0 0 0 1.5-1.2L23 7H6"/></svg>
            <span class="noor-tabbar__badge" aria-hidden="true" hidden>0</span>
        </span>
        <span>السلة</span>
    </a>
    <a class="noor-tabbar__item" href="@Url.RouteUrl(NopRouteNames.General.CUSTOMER_INFO)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
        <span>حسابي</span>
    </a>
</nav>

<script asp-location="Footer">
    (function () {
        // highlight the active bottom-nav tab
        try {
            var path = (location.pathname.replace(/\/+$/, '') || '/');
            document.querySelectorAll('.noor-tabbar__item').forEach(function (a) {
                var href = ((a.getAttribute('href') || '').replace(/\/+$/, '') || '/');
                var isHome = href === '/';
                if ((isHome && path === '/') || (!isHome && (path === href || path.indexOf(href + '/') === 0))) {
                    a.classList.add('is-active');
                }
            });
        } catch (e) { }

        // mirror the live cart item count onto the bottom-nav cart badge.
        // The header cart qty (.header-links .cart-qty) is kept current by AjaxCart
        // on every add-to-cart, so we watch it and copy the number across.
        try {
            var badge = document.querySelector('.noor-tabbar__badge');
            var qtyEl = document.querySelector('.header-links .cart-qty');
            if (badge && qtyEl) {
                var syncBadge = function () {
                    var m = (qtyEl.textContent || '').match(/\d+/);
                    var n = m ? parseInt(m[0], 10) : 0;
                    badge.textContent = n > 99 ? '99+' : n;
                    badge.hidden = !(n > 0);
                };
                syncBadge();
                new MutationObserver(syncBadge).observe(qtyEl, { childList: true, characterData: true, subtree: true });
            }
        } catch (e) { }

        // register the PWA service worker (makes the site installable)
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/noor-sw.js').catch(function () { });
            });
        }
    })();
</script>
